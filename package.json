{
  "name": "further-compare",
  "version": "2.226.0",
  "description": "Private text and folder comparison for the web and desktop",
  "author": "Further Compare",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build-native.mjs && node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "pack:mac": "npm run build && electron-builder --mac zip --arm64 --x64 --publish never",
    "pack:win": "npm run build && electron-builder --win zip --x64 --publish never",
    "downloads": "node scripts/downloads.mjs",
    "test:browser": "node test/browser.cjs",
    "test:desktop": "node test/desktop.cjs",
    "test:advanced": "node test/advanced-desktop.cjs && node test/picture-browser.cjs",
    "test:workbook": "node test/workbook-browser.cjs",
    "test:productivity": "node test/productivity-desktop.cjs",
    "test:media": "node test/media-desktop.cjs",
    "test:display": "node test/display-settings-browser.cjs",
    "test:expansion": "node test/folder-expand-desktop.cjs",
    "test:history": "node test/text-history-desktop.cjs",
    "test:archive": "node test/archive-desktop.cjs",
    "test:registry": "node test/registry-desktop.cjs",
    "test:folder-view": "node test/folder-view-desktop.cjs",
    "test:swap": "node test/advanced-swap-desktop.cjs",
    "build:native": "node scripts/build-native.mjs",
    "pretest": "npm run build:native",
    "test:clipboard": "node test/clipboard-desktop.cjs",
    "test:rename": "node test/folder-rename-desktop.cjs",
    "test:startup": "node test/startup-browser.cjs",
    "test:encoding": "node test/text-encoding-desktop.cjs",
    "test:folder-navigation": "node test/folder-navigation-desktop.cjs",
    "test:folder-recursive": "node test/folder-recursive-desktop.cjs",
    "test:folder-rules": "node test/folder-rules-desktop.cjs",
    "test:folder-report": "node test/folder-report-desktop.cjs",
    "test:alignment": "node test/text-alignment-desktop.cjs && node test/text-alignment-browser.cjs",
    "test:shell": "node test/shell-desktop.cjs",
    "test:finder-workflow": "node test/shell-macos-workflow.cjs",
    "test:folder-selection": "node test/folder-selection-desktop.cjs",
    "test:external-editor": "node test/external-editor-desktop.cjs",
    "test:folder-context": "node test/folder-context-busy-desktop.cjs",
    "test:folder-colors": "node test/folder-live-colors-desktop.cjs",
    "test:folder-timestamps": "node test/folder-timestamps-desktop.cjs",
    "test:windows-timestamps": "node --test test/windows-folder-timestamps.cjs",
    "test:copy-destination": "node test/copy-destination-desktop.cjs",
    "test:folder-open-as": "node test/folder-open-as-desktop.cjs",
    "test:folder-menu": "node test/folder-context-menu-desktop.cjs",
    "test:folder-text-rules": "node test/folder-text-rules-desktop.cjs",
    "test:folder-pair": "node test/folder-pair-desktop.cjs",
    "test:binary-alignment": "node test/binary-alignment-desktop.cjs",
    "test:binary-copy": "node test/binary-copy-desktop.cjs",
    "test:binary-range": "node test/binary-range-desktop.cjs",
    "test:folder-move": "node test/folder-move-desktop.cjs",
    "test:advanced-editor": "node test/advanced-external-editor-desktop.cjs",
    "test:editor-profiles": "node test/editor-profiles-desktop.cjs",
    "test:text-case": "node test/text-case-browser.cjs && node test/text-case-desktop.cjs",
    "test:folder-case": "node test/folder-case-rules-desktop.cjs",
    "test:workbook-formulas": "node test/workbook-formulas-browser.cjs && node test/workbook-formulas-desktop.cjs",
    "test:workbook-formatting": "node test/workbook-formatting-browser.cjs && node test/workbook-formatting-desktop.cjs",
    "test:folder-tree": "node test/folder-tree-desktop.cjs && node test/folder-tree-actions-desktop.cjs && node test/folder-tree-ui-desktop.cjs",
    "test:folder-differences": "node test/folder-difference-navigation-desktop.cjs",
    "test:text-minor": "node test/text-minor-browser.cjs && node test/text-case-desktop.cjs",
    "test:folder-child-rules": "node test/folder-child-rules-desktop.cjs",
    "test:folder-threeway": "node test/folder-threeway-desktop.cjs",
    "test:workbook-layout": "node test/workbook-layout-browser.cjs && node test/workbook-layout-desktop.cjs",
    "test:folder-properties": "node test/folder-properties-desktop.cjs",
    "test:folder-filter-session": "node test/folder-filter-session-desktop.cjs",
    "test:encoding-browser": "node test/text-encoding-browser.cjs",
    "test:text-save-browser": "node test/text-save-browser.cjs",
    "test:tab-navigation": "node test/tab-navigation-busy-desktop.cjs",
    "test:folder-page-navigation": "node test/folder-page-navigation-desktop.cjs",
    "test:folder-typeahead": "node test/folder-typeahead-desktop.cjs",
    "test:regex-search": "node test/regex-search-browser.cjs && node test/regex-search-desktop.cjs",
    "test:folder-parent-status": "node test/folder-parent-status-desktop.cjs",
    "test:aiff": "node test/aiff-desktop.cjs",
    "test:archive-races": "node test/archive-races-browser.cjs",
    "test:folder-matching-selection": "node test/folder-matching-selection-desktop.cjs",
    "test:folder-pane-focus": "node test/folder-pane-focus-desktop.cjs",
    "test:folder-columns": "node test/folder-columns-browser.cjs",
    "test:folder-columns-desktop": "node test/folder-columns-desktop.cjs",
    "test:folder-compare-queue": "node test/folder-compare-queue-desktop.cjs",
    "test:utf32-browser": "node test/utf32-browser.cjs",
    "test:batch-desktop": "node test/batch-desktop.cjs",
    "test:folder-direction": "node test/folder-direction-context-desktop.cjs",
    "test:folder-side-context": "node test/folder-side-context-desktop.cjs",
    "test:archive-save": "node test/archive-save-desktop.cjs",
    "test:folder-open-queue": "node test/folder-open-queue-desktop.cjs",
    "test:folder-node": "node test/folder-node-refresh-desktop.cjs",
    "test:archive-extract": "node test/archive-extract-desktop.cjs",
    "test:folder-drop": "node test/folder-drop-desktop.cjs",
    "test:text-drop": "node test/text-drop-desktop.cjs",
    "test:folder-comparison-metadata": "node test/folder-comparison-metadata-desktop.cjs",
    "test:folder-exclude-selected": "node test/folder-exclude-selected-desktop.cjs",
    "test:folder-one-sided-filter": "node test/folder-one-sided-filter-desktop.cjs",
    "test:folder-both-selection": "node test/folder-both-selection-desktop.cjs",
    "test:folder-display-filters": "node test/folder-display-filters-desktop.cjs",
    "test:filename-search": "node test/filename-search-desktop.cjs && node test/filename-search-focus-desktop.cjs",
    "test:folder-suppress-filters": "node test/folder-suppress-filters-desktop.cjs",
    "test:folder-filtered-operations": "node test/folder-filtered-operations-desktop.cjs",
    "test:folder-selected-compare": "node test/folder-selected-compare-desktop.cjs",
    "test:folder-always-show": "node test/folder-always-show-desktop.cjs",
    "test:close-other-tabs": "node test/tab-close-others-browser.cjs && node test/tab-close-others-desktop.cjs",
    "test:folder-new-context": "node test/folder-new-context-desktop.cjs",
    "test:folder-legend": "node test/folder-legend-desktop.cjs",
    "test:pastel": "node test/pastel-theme-desktop.cjs",
    "test:folder-chain": "node test/folder-chain-desktop.cjs",
    "test:folder-selected-refresh": "node test/folder-selected-refresh-desktop.cjs",
    "test:folder-selected-report": "node test/folder-selected-report-desktop.cjs",
    "test:folder-file-report": "node test/folder-file-report-desktop.cjs",
    "test:live-text": "node test/live-text-browser.cjs && node test/live-text-surface-browser.cjs",
    "test:folder-exclude-types": "node test/folder-exclude-types-desktop.cjs",
    "test:folder-ignored": "node test/folder-ignored-desktop.cjs",
    "test:folder-filtered-review": "node test/folder-filtered-review-desktop.cjs",
    "test:folder-parent-pair": "node test/folder-parent-pair-desktop.cjs",
    "test:workspace": "node test/workspace-desktop.cjs",
    "test:session-clear": "node test/session-clear-desktop.cjs",
    "test:compare-parents": "node test/compare-parents-desktop.cjs",
    "test:folder-update-both": "node test/folder-update-both-desktop.cjs",
    "test:session-lock": "node test/session-lock-desktop.cjs",
    "test:filename-matching": "node test/folder-filename-desktop.cjs",
    "build:finder": "node scripts/build-finder-extension.mjs",
    "test:finder-native": "node test/finder-native-policy.cjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@xmldom/xmldom": "0.8.15",
    "@zip.js/zip.js": "2.24.0",
    "buffer": "5.7.1",
    "diff": "^8.0.2",
    "exceljs": "^4.4.0",
    "iconv-lite": "0.7.2",
    "ssh2": "1.17.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "pdfjs-dist": "6.2.108"
  },
  "build": {
    "appId": "com.furthercompare.desktop",
    "productName": "Further Compare",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/downloads/**",
      "desktop/**/*",
      "package.json",
      "src/text-codec.cjs",
      "src/multibyte-text-codec.cjs",
      "src/single-byte-text-codec.cjs",
      "src/table-difference-copy.cjs",
      "src/text-patch-apply.cjs",
      "scripts/batch.cjs",
      "scripts/compare.cjs",
      "src/diff.cjs",
      "src/structured-diff.cjs",
      "src/folder-view.cjs",
      "src/windows-codepages.cjs",
      "src/folder-refresh.cjs",
      "src/folder-time.cjs",
      "src/folder-name-rules.cjs",
      "src/text-whitespace.cjs",
      "src/text-blank-lines.cjs",
      "src/text-profile.cjs",
      "src/text-grammar.cjs",
      "src/text-comparison-keys.cjs",
      "src/ignored-text-rules.cjs",
      "src/ignored-text-normalize.cjs",
      "src/text-input.cjs",
      "src/compound-file.cjs",
      "src/doc-preflight.cjs",
      "src/doc-story-ranges.cjs",
      "src/doc-text-engine.cjs",
      "src/doc-projection.cjs",
      "src/doc-text.cjs",
      "src/doc-worker-client.cjs",
      "src/doc-worker-handler.cjs",
      "src/doc-text-node.cjs",
      "src/doc-text-node-worker.cjs",
      "src/docx-text.cjs",
      "src/rtf-text.cjs",
      "src/odt-text.cjs",
      "src/ods-input.cjs",
      "src/workbook-sheet-metadata.cjs",
      "src/ods-formula.cjs",
      "src/ods-cell-edits.cjs",
      "src/document-projection.cjs",
      "src/archive-core.cjs",
      "src/zip-preserve.cjs",
      "src/tar-core.cjs",
      "src/workbook-cell-edits.cjs",
      "src/workbook-conditional.cjs",
      "src/workbook-number-formats.cjs",
      "src/workbook-style-edits.cjs",
      "src/workbook-structural-plan.cjs",
      "src/workbook-structural-formulas.cjs",
      "src/pdf-text-core.mjs",
      "src/pdf-page-order.mjs",
      "src/pdf-tagged-order.mjs",
      "src/pdf-text-node.cjs",
      "src/pdf-text-node-child.cjs"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "artifactName": "Further-Compare-mac-${arch}.${ext}",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "build/native/rename-directory",
          "to": "native/rename-directory"
        }
      ],
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.furthercompare.shell",
            "CFBundleURLSchemes": [
              "furthercompare"
            ],
            "CFBundleTypeRole": "Viewer"
          }
        ]
      }
    },
    "win": {
      "artifactName": "Further-Compare-windows-${arch}.${ext}",
      "icon": "build/icon.ico",
      "signExecutable": false,
      "extraResources": [
        {
          "from": "desktop/native/rename-directory.ps1",
          "to": "native/rename-directory.ps1"
        },
        {
          "from": "desktop/native/folder-timestamps.ps1",
          "to": "native/folder-timestamps.ps1"
        },
        {
          "from": "desktop/native/folder-attributes.ps1",
          "to": "native/folder-attributes.ps1"
        }
      ]
    },
    "npmRebuild": false,
    "afterPack": "scripts/package-finder-extension.cjs"
  }
}
